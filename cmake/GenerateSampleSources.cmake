# GenerateSampleSources.cmake
#
# Reads the three python/samples/*.py files and writes src/generated/
# sample_sources.h containing their source text as escaped C string literals.
# This keeps the plugin's placeholder (which renders the sample source) in sync
# with the real, runnable samples.
#
# Run in two ways:
#   - as a -P script (used by the build-time custom command), with
#     SAMPLE_480P / SAMPLE_720P / SAMPLE_1080P / OUTPUT_FILE defined on the
#     command line;
#   - via the generate_sample_sources(<target>) function below, which wires the
#     custom command into a target so editing any sample regenerates the header.

# ---- Escape helper: turn raw file text into a C string-literal body. --------
function(_escape_to_c_literal RAW OUT_VAR)
  # Order matters: backslash first, then quotes, then newlines.
  string(REPLACE "\\" "\\\\" _s "${RAW}")
  string(REPLACE "\"" "\\\"" _s "${_s}")
  # CMake reads CRLF as LF already; normalise any stray CR then map LF.
  string(REPLACE "\r" "" _s "${_s}")
  string(REPLACE "\n" "\\n\"\n    \"" _s "${_s}")
  set(${OUT_VAR} "${_s}" PARENT_SCOPE)
endfunction()

function(_emit_header out_file p480 p720 p1080)
  file(READ "${p480}" _raw480)
  file(READ "${p720}" _raw720)
  file(READ "${p1080}" _raw1080)

  _escape_to_c_literal("${_raw480}" _lit480)
  _escape_to_c_literal("${_raw720}" _lit720)
  _escape_to_c_literal("${_raw1080}" _lit1080)

  set(_content "/*\n")
  string(APPEND _content " * sample_sources.h — GENERATED by cmake/GenerateSampleSources.cmake.\n")
  string(APPEND _content " * Do not edit by hand. Edit the python/samples scripts and rebuild.\n")
  string(APPEND _content " *\n")
  string(APPEND _content " * Each literal is the exact source text of the matching Python sample,\n")
  string(APPEND _content " * rendered by the plugin placeholder for the corresponding resolution.\n")
  string(APPEND _content " */\n\n")
  string(APPEND _content "#ifndef PY_VIRTUAL_CAM_SAMPLE_SOURCES_H\n")
  string(APPEND _content "#define PY_VIRTUAL_CAM_SAMPLE_SOURCES_H\n\n")
  string(APPEND _content "static const char *SAMPLE_SRC_480P =\n    \"${_lit480}\";\n\n")
  string(APPEND _content "static const char *SAMPLE_SRC_720P =\n    \"${_lit720}\";\n\n")
  string(APPEND _content "static const char *SAMPLE_SRC_1080P =\n    \"${_lit1080}\";\n\n")
  string(APPEND _content "#endif /* PY_VIRTUAL_CAM_SAMPLE_SOURCES_H */\n")

  file(WRITE "${out_file}" "${_content}")
endfunction()

# When invoked as `cmake -P GenerateSampleSources.cmake` the script mode runs
# this branch (CMAKE_SCRIPT_MODE_FILE is set only for -P).
if(CMAKE_SCRIPT_MODE_FILE)
  _emit_header("${OUTPUT_FILE}" "${SAMPLE_480P}" "${SAMPLE_720P}" "${SAMPLE_1080P}")
endif()

# ---- Target wiring: regenerate at build time when a sample changes. ---------
function(generate_sample_sources TARGET)
  set(_samples_dir "${CMAKE_SOURCE_DIR}/python/samples")
  set(_p480 "${_samples_dir}/sample_480p.py")
  set(_p720 "${_samples_dir}/sample_720p.py")
  set(_p1080 "${_samples_dir}/sample_1080p.py")
  set(_out_dir "${CMAKE_SOURCE_DIR}/src/generated")
  set(_out "${_out_dir}/sample_sources.h")

  file(MAKE_DIRECTORY "${_out_dir}")

  # Generate once at configure time so a fresh tree has the header before the
  # first build, then again at build time whenever a sample changes.
  _emit_header("${_out}" "${_p480}" "${_p720}" "${_p1080}")

  add_custom_command(
    OUTPUT "${_out}"
    COMMAND
      "${CMAKE_COMMAND}" -DSAMPLE_480P=${_p480} -DSAMPLE_720P=${_p720}
      -DSAMPLE_1080P=${_p1080} -DOUTPUT_FILE=${_out} -P
      "${CMAKE_SOURCE_DIR}/cmake/GenerateSampleSources.cmake"
    DEPENDS "${_p480}" "${_p720}" "${_p1080}"
            "${CMAKE_SOURCE_DIR}/cmake/GenerateSampleSources.cmake"
    COMMENT "Generating src/generated/sample_sources.h from python/samples"
    VERBATIM
  )
  add_custom_target(generate_sample_sources_target DEPENDS "${_out}")
  add_dependencies(${TARGET} generate_sample_sources_target)
  target_sources(${TARGET} PRIVATE "${_out}")
endfunction()
